// Practical 6
// Title: Demonstrate Function Overloading
// and Operator Overloading.


#include <iostream>
using namespace std;

class Calculator
{
public:

    // Function Overloading
    int add(int a, int b)
    {
        return a + b;
    }

    float add(float a, float b)
    {
        return a + b;
    }

    // Operator Overloading
    Calculator operator + (Calculator obj)
    {
        Calculator temp;
        temp.add(0, 0); // Demonstration of function call
        return temp;
    }
};

class Number
{
public:
    int value;

    Number(int v)
    {
        value = v;
    }

    // Operator Overloading
    Number operator + (Number obj)
    {
        return Number(value + obj.value);
    }
};

int main()
{
    Calculator c;

    cout << "Function Overloading:" << endl;
    cout << "Addition of integers: "
         << c.add(10, 20) << endl;

    cout << "Addition of floats: "
         << c.add(5.5f, 2.5f) << endl;

    cout << "\nOperator Overloading:" << endl;

    Number n1(10), n2(20);
    Number n3 = n1 + n2;

    cout << "Addition of two objects: "
         << n3.value << endl;

    return 0;
}
